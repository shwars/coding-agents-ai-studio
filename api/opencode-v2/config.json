{
  "$schema": "https://opencode.ai/config.json",
  "websearch": {
    "provider": "parallel"
  },
  "providers": {
    "yandex": {
      "name": "Yandex",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.api.cloud.yandex.net/v1",
        "apiKey": "{env:api_key}"
      },
      "models": {
        "DeepSeek-V4.1-Flash": {
          "modelID": "gpt://{env:folder_id}/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high"]
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 32678
          },
          "cost": {
            "input": 2.459016,
            "output": 4.09836,
            "cache": {
              "read": 0.614754,
              "write": 0.614754
            }
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } }
          ]
        },
        "DeepSeek-V4-Flash": {
          "modelID": "gpt://{env:folder_id}/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["minimal", "low", "medium", "high", "xhigh"]
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 32678
          },
          "cost": {
            "input": 2.459016,
            "output": 4.09836,
            "cache": {
              "read": 0.614754,
              "write": 0.614754
            }
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } }
          ]
        },
        "Qwen36": {
          "modelID": "gpt://{env:folder_id}/qwen3.6-35b-a3b",
          "name": "Qwen3 35B (V4)",
          "capabilities": {
            "tools": true,
            "input": ["text", "audio", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["minimal", "low", "medium", "high", "xhigh"]
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 262144,
            "output": 32678
          },
          "cost": {
            "input": 1.639344,
            "output": 2.459016,
            "cache": {
              "read": 0.409836,
              "write": 0.409836
            }
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } }
          ]
        }
      }
    }
  }
}
