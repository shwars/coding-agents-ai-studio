{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "yandex": {
      "name": "Yandex Cloud (Алиса AI Про)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://apps.ai.api.cloud.yandex.net/v1"
      },
      "headers": {
        "OpenAI-Project": "{env:folder_id}"
      },
      "models": {
        "DeepSeek-V4.1-Flash": {
          "modelID": "gpt://{env:folder_id}/deepseek-v4.1-flash/latest",
          "name": "DeepSeek V4.1 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high"]
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } }
          ]
        },
        "DeepSeek-V4-Flash": {
          "modelID": "gpt://{env:folder_id}/deepseek-v4-flash/latest",
          "name": "DeepSeek V4 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["minimal", "low", "medium", "high", "xhigh"]
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } }
          ]
        }
      }
    }
  }
}
